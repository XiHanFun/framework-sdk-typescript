{
  "name": "xihan-framework",
  "version": "0.2.0-rc.1",
  "description": "XiHan Framework 的 TypeScript SDK：原语、清单、调用上下文、管道、操作契约与进程外插件运行时",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/framework-sdk-typescript.git"
  },
  "homepage": "https://framework.docs.xihanfun.com",
  "exports": {
    "./primitives": {
      "xihan-source": "./src/primitives/index.ts",
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./manifest": {
      "xihan-source": "./src/manifest/index.ts",
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/node": {
      "xihan-source": "./src/manifest/node.ts",
      "types": "./dist/manifest/node.d.ts",
      "default": "./dist/manifest/node.js"
    },
    "./invocation": {
      "xihan-source": "./src/invocation/index.ts",
      "types": "./dist/invocation/index.d.ts",
      "default": "./dist/invocation/index.js"
    },
    "./pipeline": {
      "xihan-source": "./src/pipeline/index.ts",
      "types": "./dist/pipeline/index.d.ts",
      "default": "./dist/pipeline/index.js"
    },
    "./operation": {
      "xihan-source": "./src/operation/index.ts",
      "types": "./dist/operation/index.d.ts",
      "default": "./dist/operation/index.js"
    },
    "./plugin": {
      "xihan-source": "./src/plugin/index.ts",
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/plugin/messages.js",
    "./src/plugin/messages.ts"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node --conditions=xihan-source --test \"test/*.test.ts\"",
    "check": "biome check .",
    "format": "biome check --write .",
    "generate": "buf generate"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.7"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protobuf": "2.17.0",
    "@grpc/grpc-js": "1.14.7",
    "@types/node": "24.10.15",
    "ts-proto": "2.22.0",
    "typescript": "5.8.3"
  }
}
